# ==== Supabase ====
# Found in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The anon key, used for sign-in. Left blank, the service-role key is used
# instead: that works, but the anon key is the correct one for this.
SUPABASE_ANON_KEY=your-anon-key

# ==== Cloudflare R2 ====
# Found in Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=doc-chatbot-demo
# Only needed if the bucket is public. Downloads use short-lived signed links,
# so the bucket can and should stay private.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ==== Voyage AI (embeddings — 200M tokens free) ====
VOYAGE_API_KEY=pa-xxxxxxxx
# Optional: route through an internal proxy or gateway instead of calling
# api.voyageai.com directly.
# VOYAGE_BASE_URL=

# ==== Gemini (OCR for scanned PDFs) ====
# Get a key at https://aistudio.google.com/apikey
# Left blank the app still runs, but uploading a scanned PDF will fail.
GEMINI_API_KEY=
# Models to try in order, comma separated. When the first one reports overload
# (503 "model is overloaded"), the next one is tried automatically.
GEMINI_OCR_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Retry rounds per page batch; each round walks the whole model list above.
OCR_RETRY_ROUNDS=5
# How many times a whole document is rescheduled when Gemini stays overloaded.
OCR_DOC_RETRIES=3
# Hard page cap per scanned file, so one upload cannot run up an unexpected bill.
OCR_MAX_PAGES=30
# Pages sent per API call. Small batches avoid truncated responses.
OCR_PAGES_PER_BATCH=5

# ==== Document processing queue ====
# A 512 MB instance should stay at 1. A larger machine can run 2-3.
WORKER_CONCURRENCY=1
WORKER_MAX_QUEUE=20

# ==== DeepSeek (answer generation) ====
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Which language the chatbot answers in.
#   auto  (default) - answer in the same language the question was asked in,
#                     whatever language the uploaded documents are written in.
#   <name>          - always answer in that language, for example English,
#                     French or Japanese. Use this when every answer has to be
#                     in one language regardless of who is asking.
BOT_REPLY_LANGUAGE=auto

# ==== Payments: PayPal ====
# Create an app at https://developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# IMPORTANT: a Live PayPal app REQUIRES this to be "live".
# Leaving it at "sandbox" while pasting Live credentials sends those credentials
# to the sandbox endpoint, and PayPal answers "Client Authentication failed" —
# which reads exactly like a wrong key. The System health page detects this
# case and says so explicitly.
PAYPAL_ENV=sandbox
# Copy this after creating the webhook in the PayPal Developer Dashboard.
PAYPAL_WEBHOOK_ID=

# ==== General payment settings ====
# The app's public address, used to build the post-payment return link and to
# register webhooks. On Render this may be left blank: RENDER_EXTERNAL_URL is
# read automatically. Set it explicitly once a custom domain is in use.
APP_BASE_URL=

# ==== System administration ====
# Addresses listed here ALWAYS have system-administrator access, even when the
# database flag is not set. Use it to create the first administrator without
# running SQL by hand, and as a way back in if every admin account is lost.
# Separate several addresses with commas.
# Note: on first sign-in the flag is also written to the database, so removing
# an address from here does NOT revoke access. Revoke it properly with
# `npm run make-admin -- admin@company.com --revoke` or from the Users page.
SYSTEM_ADMIN_EMAILS=

# ==== Free trial ====
# Secret for the purge endpoint: POST /cron/purge-trials
# Point a free cron service (cron-job.org and similar) at it, sending the
# x-cron-secret header. Left blank the endpoint is disabled and expired data is
# still purged opportunistically on incoming traffic.
CRON_SECRET=
# Grace period in hours after expiry before data is actually deleted (0 = at once)
TRIAL_GRACE_HOURS=0

# ==== Server ====
PORT=3000
