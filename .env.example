# ==== Supabase ====
# Lấy trong Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# anon key — dùng cho thao tác đăng nhập (nếu bỏ trống sẽ tạm dùng service_role)
SUPABASE_ANON_KEY=your-anon-key

# ==== Cloudflare R2 ====
# Lấy trong Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=doc-chatbot-demo
# Chỉ cần khi bucket để public. Hệ thống đã dùng link ký tạm thời nên có thể để bucket riêng tư.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ==== Voyage AI (tạo embedding — có 200 triệu token miễn phí) ====
VOYAGE_API_KEY=pa-xxxxxxxx
# Tuỳ chọn: trỏ qua proxy/gateway nội bộ thay vì gọi thẳng api.voyageai.com
# VOYAGE_BASE_URL=

# ==== Gemini (nhận dạng chữ trong PDF scan - OCR) ====
# Lấy tại https://aistudio.google.com/apikey
# Bỏ trống thì hệ thống vẫn chạy, nhưng PDF dạng scan sẽ báo lỗi khi tải lên.
GEMINI_API_KEY=
# Chuỗi model thử lần lượt, ngăn cách bằng dấu phẩy. Khi model đầu báo quá tải
# (lỗi 503 "model is overloaded"), hệ thống tự chuyển sang model kế tiếp.
GEMINI_OCR_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Số vòng thử lại cho mỗi lô trang (mỗi vòng đi qua tất cả model ở trên)
OCR_RETRY_ROUNDS=5
# Số lần tự hẹn giờ chạy lại cả tài liệu khi Gemini quá tải kéo dài
OCR_DOC_RETRIES=3
# Số trang tối đa cho mỗi file scan (chặn cứng để không phát sinh chi phí ngoài dự tính)
OCR_MAX_PAGES=30
# Số trang gửi mỗi lần gọi API. Lô nhỏ tránh bị cắt kết quả.
OCR_PAGES_PER_BATCH=5

# ==== Hàng đợi xử lý tài liệu ====
# Render Free chỉ có 512 MB RAM nên để 1. Máy khoẻ hơn có thể tăng lên 2-3.
WORKER_CONCURRENCY=1
WORKER_MAX_QUEUE=20

# ==== DeepSeek (sinh câu trả lời) ====
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==== Thanh toán: payOS (khách Việt Nam, VietQR) ====
# Đăng ký tại https://payos.vn — chỉ cần CCCD, khoảng 5 phút.
# Lấy trong Kênh thanh toán > Thông tin kênh.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ==== Thanh toán: PayPal (khách ngoài Việt Nam, USD) ====
# Tạo app tại https://developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox khi chạy thử, live khi bán thật
PAYPAL_ENV=sandbox
# Lấy sau khi tạo webhook trong PayPal Developer Dashboard
PAYPAL_WEBHOOK_ID=

# ==== Cấu hình thanh toán chung ====
# URL công khai của ứng dụng, dùng cho link quay về sau khi thanh toán.
# Trên Render có thể bỏ trống vì hệ thống tự đọc RENDER_EXTERNAL_URL.
APP_BASE_URL=
# Tỷ giá CHỈ dùng để quy đổi doanh thu USD sang VNĐ cho báo cáo,
# không dùng để tính tiền khách.
USD_TO_VND_RATE=26000

# ==== Server ====
PORT=3000
