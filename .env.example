# ==== Supabase ====
# Lấy trong Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==== Cloudflare R2 ====
# Lấy trong Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=doc-chatbot-demo
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ==== Voyage AI (dùng để tạo embedding - có 200 triệu token miễn phí) ====
VOYAGE_API_KEY=pa-xxxxxxxx

# ==== DeepSeek (dùng để sinh câu trả lời chat) ====
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==== Server ====
PORT=3000
